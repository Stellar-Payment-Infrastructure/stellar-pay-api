{
  "name": "stellar-pay-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Stellar Pay API (testnet)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./webhooks": {
      "import": { "types": "./dist/webhooks.d.ts", "default": "./dist/webhooks.js" },
      "require": { "types": "./dist/webhooks.d.cts", "default": "./dist/webhooks.cjs" }
    }
  },
  "files": ["dist", "openapi.json", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/openapi.ts",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry": "pnpm pack --pack-destination ./.pack"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "tsup": "9.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  },
  "publishConfig": { "access": "public" }
}
