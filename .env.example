# Copy to .env and fill in the three secrets. Never commit .env.
# Testnet only: the API refuses to start with the public network passphrase.
# Variable names and defaults come from src/config.ts.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. For a quick local run without Postgres, `pglite://./.data/dev`
# starts an embedded database (development/demo only).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_pay_api

STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The deployed testnet contract and its token (stellar-pay-core deployments/testnet.json).
PAY_CONTRACT_ID=CDB5PL5RITGAI6FBYTICPZMQIFROZEMXYMSKFGVK5NOUEX2XLYQ3IS4I
PAY_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
PAY_TOKEN_CODE=XLM
PAY_TOKEN_DECIMALS=7

# --- Secrets: generate your own ---
# Operator account (testnet). It authorizes create/settle/cancel/refund:
#   stellar keys generate sp-operator --network testnet --fund
#   stellar keys secret sp-operator
OPERATOR_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
API_KEY_PEPPER=
# 32 bytes as 64 hex characters, e.g. `openssl rand -hex 32`. Encrypts webhook secrets at rest.
WEBHOOK_SECRET_ENC_KEY=

# --- Optional (defaults shown) ---
# MAX_PAYMENT_AMOUNT=9223372036854775807
# MAX_PAY_TX_FEE=10000000
# INDEXER_POLL_MS=5000
# INDEXER_START_LEDGER=0
# RECONCILE_INTERVAL_MS=60000
# RECONCILE_AFTER_MS=120000
# WEBHOOK_POLL_MS=2000
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_ALLOW_INSECURE=false
# PUBLIC_RATE_LIMIT_PER_MIN=60
# CORS_ORIGINS=http://localhost:3001
# CHECKOUT_BASE_URL=http://localhost:3001
# WORKERS_ENABLED=true
# MIGRATE_ON_START=true
