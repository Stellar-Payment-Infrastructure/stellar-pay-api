{
  "name": "stellar-pay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API for Stellar Pay: API keys, payments, transaction builder, Soroban event indexer, signed webhooks",
  "license": "MIT",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "sdk:sync": "pnpm openapi:generate && node -e \"require('node:fs').copyFileSync('openapi/openapi.json','sdk/openapi.json')\" && pnpm --dir sdk generate"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@stellar/stellar-sdk": "16.4.1",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.26.2",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "follow-redirects": "1.16.2",
      "qs": "6.16.1"
    }
  }
}
